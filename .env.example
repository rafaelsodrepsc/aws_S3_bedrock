AWS_REGION=us-east-2
DOCS_BUCKET=
KB_ID=
DATA_SOURCE_ID=
# Separados por vírgula; o primeiro é o padrão do /ask
MODEL_ARNS=
# Pelo menos 16 caracteres: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
UPLOAD_TTL_SECONDS=300
UPLOADS_PER_MINUTE=120
# Com Cloudflare Tunnel, ative o limite por pessoa com cf-connecting-ip
CLIENT_IP_HEADER=
UPLOADS_PER_MINUTE_PER_CLIENT=10
